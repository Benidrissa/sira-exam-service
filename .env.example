# ── Shared with Sira ────────────────────────────────────────────────────────
SIRA_JWT_SECRET=change-in-production

# PostgreSQL — shared instance, isolated exam_svc schema
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sira_db
DATABASE_SCHEMA=exam_svc

# Redis — shared instance, keys namespaced exam:*
REDIS_URL=redis://redis:6379/0

# MinIO — shared instance
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_EXAM_BUCKET=exam-evidence
MINIO_USE_SSL=false

# ── Exam service own ─────────────────────────────────────────────────────────
EXAM_ANTHROPIC_API_KEY=sk-ant-...
EXAM_WATERMARK_SECRET=change-in-production-32-bytes-hex
EXAM_EVIDENCE_RETENTION_DAYS=2555

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_EXAM_API_URL=http://localhost:8001/api/v1

# ── Optional ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
FRONTEND_URL=http://localhost:3001
